# ──────────────────────────────────────────────────────────────────────────────
# NUVIA — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to ./nuvia.db (project root) if not set
DB_PATH=./nuvia.db

# ── Network ──────────────────────────────────────────────────────────────────
# arc-testnet | arc-mainnet
NUVIA_NETWORK=arc-testnet

# ── Arc / Circle ──────────────────────────────────────────────────────────────
# Used by the frontend to read the USDC token address and RPC URL.
# These are resolved automatically from @/onchain-facts for Arc Testnet.
# Override only if pointing to a custom RPC.
# VITE_ARC_RPC_URL=https://rpc.arc.io

# ── Circle Developer API (optional — for SCP integration in v2) ───────────────
# CIRCLE_DEVELOPER_CONTROLLED_API_KEY=your_key_here
# CIRCLE_ENTITY_SECRET=your_entity_secret_here

# ── Demo mode ─────────────────────────────────────────────────────────────────
# When VITE_DEMO_MODE=true, payments run without a connected wallet.
# On-chain transactions are simulated with a fake tx hash.
VITE_DEMO_MODE=true
